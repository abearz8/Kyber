# Copy to .env.local and fill in. .env.local is git-ignored.

# Anthropic API key — server-side only, powers real syllabus parsing.
# Never prefix with NEXT_PUBLIC_ (that would expose it to the browser).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PostHog analytics (optional). Project API Key is the phc_... token.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
